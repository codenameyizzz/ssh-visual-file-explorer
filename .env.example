# Optional local server settings.
# The app will still run without this file and default to PORT=3000 and HOST=0.0.0.0.
PORT=3000
HOST=0.0.0.0

# Optional Vite flag. Set to true only if you want to disable HMR.
DISABLE_HMR=false

# Required in production (for example on Vercel) to encrypt short-lived download tokens.
DOWNLOAD_TOKEN_SECRET=change-this-to-a-long-random-secret
